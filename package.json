{
  "name": "bochi-12-birthday-quest",
  "version": "1.0.0",
  "description": "Bochi 12th Birthday Surprise - ARG Detective Puzzle Game",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:portable": "pnpm run build && electron-builder --win portable",
    "dist:nsis": "pnpm run build && electron-builder --win nsis",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy.ps1"
  },
  "keywords": [],
  "author": "Mama Ley",
  "license": "ISC",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-solid": "^2.11.6",
    "wait-on": "^8.0.2"
  }
}
